<div class="news-media @CssClass">
    @if (!Failed && !string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" alt="" loading="lazy" @onerror="() => Failed = true" />
    }
    else
    {
        <div class="news-fallback"><span class="news-fallback-symbol" aria-hidden="true">✦</span><span>@Category</span></div>
    }
</div>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Category { get; set; } = "Notícias";
    private bool Failed;
    private string? PreviousImageUrl;
    protected override void OnParametersSet()
    {
        if (ImageUrl != PreviousImageUrl)
        {
            Failed = false;
            PreviousImageUrl = ImageUrl;
        }
    }
}
