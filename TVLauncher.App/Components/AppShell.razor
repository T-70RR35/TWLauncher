@using System.IO
@implements IAsyncDisposable
@inject LauncherRepository Repository
@inject WindowsHostService Host
@inject WeatherService WeatherService
@inject NewsService NewsService
@inject TrendingCatalogService TrendingCatalogService
@inject StreamingProviderDirectory StreamingProviders
@inject CatalogCredentialsService CatalogCredentials
@inject FeaturedRotationService RotationService
@inject AppIconService IconService
@inject LauncherUpdateService Updater
@inject SystemPowerService PowerService
@inject IJSRuntime Js

<div class="shell focus-shell">
    <aside class="focus-rail" aria-label="Navegação do TW Launcher">
        <button class="focus-logo" @onclick='() => SwitchTab("home")' aria-label="TW Launcher — Início" title="Início">
            <img src="img/tw-brand.png" alt="" />
        </button>
        <nav class="focus-nav" aria-label="Menu principal">
            <button class="focus-nav-item @(Tab == "home" ? "focus-active" : "")" @onclick='() => SwitchTab("home")' aria-label="Início" title="Início">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z" /></svg><span>Início</span>
            </button>
            <button class="focus-nav-item @(Tab == "apps" ? "focus-active" : "")" @onclick='() => SwitchTab("apps")' aria-label="Aplicativos" title="Apps">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg><span>Apps</span>
            </button>
            <button class="focus-nav-item @(Tab == "news" ? "focus-active" : "")" @onclick='() => SwitchTab("news")' aria-label="Notícias" title="Notícias">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><span>Notícias</span>
            </button>
            <button class="focus-nav-item @(Tab == "weather" ? "focus-active" : "")" @onclick='() => SwitchTab("weather")' aria-label="Clima" title="Clima">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18h11a4 4 0 0 0 0-8 6 6 0 0 0-11.5 1.5A3.3 3.3 0 0 0 7 18Z"/><path d="M7 5v2M3 8l2 1"/></svg><span>Clima</span>
            </button>
        </nav>
        <button class="focus-nav-item focus-settings @(Tab == "settings" ? "focus-active" : "")" @onclick='() => SwitchTab("settings")' aria-label="Configurações" title="Configurações">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68h.06a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.06a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09A1.65 1.65 0 0 0 19.4 15z"/></svg><span>Ajustes</span>
        </button>
        <button class="focus-nav-item focus-power" @onclick="OpenPowerMenu" aria-label="Energia do computador" title="Energia">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v10"/><path d="M6.3 5.8a9 9 0 1 0 11.4 0"/></svg><span>Energia</span>
        </button>
    </aside>
    <div class="focus-main">
        <header class="focus-topbar" aria-label="Barra superior">
            <div class="focus-page-identity">
                <span class="focus-appname">TW LAUNCHER</span>
                <strong>@TabTitle</strong>
            </div>
            <div class="focus-topbar-right">
                <button class="focus-search-trigger" title="Pesquisar no catálogo" aria-label="Pesquisar filmes e séries" aria-expanded="@ShowSearch" @onclick="ToggleSearch">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5"/><path d="m16 16 5 5"/></svg>
                </button>
                <button class="focus-weather" @onclick='() => SwitchTab("weather")' title="Ver previsão do tempo">
                    <span aria-hidden="true">☁</span> @(Weather is null ? "--°" : $"{Weather.Temperature}°")
                </button>
                <div class="focus-time"><strong>@Now.ToString("HH:mm")</strong><span>@Now.ToString("ddd, dd MMM", new System.Globalization.CultureInfo("pt-BR"))</span></div>
            </div>
        </header>

    @if (ShowSearch)
    {
        <section class="search-panel" aria-label="Pesquisa do catálogo">
            <div class="search-input-wrap">
                <span aria-hidden="true">⌕</span>
                <input placeholder="Buscar filmes ou séries..." @bind="SearchText" @bind:event="oninput" aria-label="Buscar filmes e séries" />
                <button @onclick="CloseSearch" aria-label="Fechar pesquisa">×</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(SearchText))
            {
                <div class="search-results">
                    @if (SearchResults.Count == 0)
                    {
                        <p>Nenhum título encontrado no catálogo local.</p>
                    }
                    @foreach (var result in SearchResults)
                    {
                        <button @key="result.RotationKey" @onclick="() => OpenSearchResultAsync(result)">
                            <img src="@result.ImageUrl" alt="" loading="lazy" />
                            <span><strong>@result.Title</strong><small>@result.Provider</small></span>
                        </button>
                    }
                </div>
            }
        </section>
    }

    @if (Tab == "home")
    {
        <main class="home-content">
            @if (Featured.Count > 0)
            {
                var selected = Featured[ActiveFeature];
                <section class="cinema-hero hero-premium" @ref="HeroElement"
                         aria-label="Destaque: @selected.Title">
                    <div class="hero-wallpaper" style="background-image: url('@selected.ImageUrl')" aria-hidden="true"></div>
                    <div class="hero-content" @key="HeroContentKey(selected)">
                        <div class="focus-feature-label"><span class="focus-feature-line"></span> EM DESTAQUE</div>
                        <div class="hero-eyebrow">@selected.Provider <span class="focus-dot-divider">·</span> @selected.Category</div>
                        <h1 class="@(selected.Title.Length > 48 ? "hero-title-long" : selected.Title.Length > 30 ? "hero-title-medium" : "")">@selected.Title</h1>
                        <div class="hero-pills"><span>@selected.Category</span></div>
                        @if (!string.IsNullOrWhiteSpace(selected.Synopsis))
                        {
                            <p class="hero-synopsis">@selected.Synopsis</p>
                        }
                        <div class="hero-actions">
                            <button class="primary-btn" @onclick="() => WatchFeatured(selected)" aria-label="Assistir @selected.Title">
                                <span aria-hidden="true">▶</span> Assistir agora
                            </button>
                            <button class="hero-details-btn" @onclick="() => ShowFeaturedDetails = true" aria-label="Ver detalhes de @selected.Title">
                                Detalhes
                            </button>
                        </div>
                    </div>
                    <div class="hero-showcase" @key="HeroShowcaseKey(selected)">
                        <div class="hero-showcase-heading">
                            <span class="showcase-kicker"><span class="showcase-live-dot"></span> @(string.IsNullOrWhiteSpace(selected.TrailerVideoId) ? "EM DESTAQUE" : "PRÉVIA DO TRAILER")</span>
                            @if (PlayTrailer && !string.IsNullOrWhiteSpace(selected.TrailerVideoId))
                            {
                                <button type="button" class="trailer-audio-button" data-trailer-audio
                                        title="Ativar som do trailer" aria-label="Ativar som do trailer">🔊</button>
                            }
                        </div>
                        <div class="hero-player-area">
                            <div class="hero-media-still" style="background-image: url('@selected.ImageUrl')" aria-hidden="true"></div>
                            @if (PlayTrailer && !string.IsNullOrWhiteSpace(selected.TrailerVideoId))
                            {
                                <iframe @key="selected.RotationKey" class="hero-iframe"
                                        src="@EmbedUrl(selected.TrailerVideoId!)"
                                        title="Trailer de @selected.Title"
                                        allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                                        referrerpolicy="strict-origin-when-cross-origin"
                                        allowfullscreen></iframe>
                            }
                            else
                            {
                                <div class="player-placeholder" style="background-image: url('@selected.ImageUrl')">
                                    <div class="player-placeholder-scrim">
                                        @if (!string.IsNullOrWhiteSpace(selected.TrailerVideoId))
                                        {
                                            <span class="play-outline" aria-hidden="true">▶</span>
                                            <span class="preview-hint">Trailer disponível</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="hero-arrows" aria-label="Navegar pelos destaques">
                        <button class="ghost-btn" @onclick="PreviousFeaturedAsync" aria-label="Destaque anterior" title="Anterior">‹</button>
                        <button class="ghost-btn" @onclick="() => NextFeaturedAsync(manual: true)" aria-label="Próximo destaque" title="Próximo">›</button>
                    </div>
                    <div class="hero-bottom-rule" aria-hidden="true"></div>
                    <div class="hero-progress hero-progress-premium" @ref="HeroSelectorElement"
                     aria-label="Navegação dos destaques">
                    <span class="progress-current">@((ActiveFeature + 1).ToString("00"))</span>
                    <div class="hero-segments">
                        @* Cada indicador representa uma posição fixa na fila desta visita. *@
                        @for (var i = 0; i < Featured.Count; i++)
                        {
                            var index = i;
                            <button @key="index" type="button" title="Ver @Featured[index].Title"
                                    class="progress-dot @(index == ActiveFeature ? "progress-selected" : "")"
                                    aria-label="Selecionar destaque: @Featured[index].Title"
                                    aria-current="@(index == ActiveFeature ? "true" : null)"
                                    @onmouseenter="() => PreviewFeaturedAsync(index)"
                                    @onfocus="() => PreviewFeaturedAsync(index)"
                                    @onclick="() => SetFeaturedAsync(index)"></button>
                        }
                    </div>
                    <span class="progress-total">/ @Featured.Count.ToString("00")</span>
                    </div>
                </section>
                @if (ShowFeaturedDetails)
                {
                    <div class="feature-details-overlay" role="presentation" @onclick="() => ShowFeaturedDetails = false">
                        <section class="feature-details-dialog" role="dialog" aria-modal="true" aria-label="Detalhes de @selected.Title" @onclick:stopPropagation="true">
                            <button class="feature-details-close" @onclick="() => ShowFeaturedDetails = false" aria-label="Fechar detalhes">×</button>
                            <span class="feature-details-kicker">@selected.Provider · @selected.Category</span>
                            <h2>@selected.Title</h2>
                            @if (!string.IsNullOrWhiteSpace(selected.Genres)) { <p class="feature-details-genres">@selected.Genres</p> }
                            <p class="feature-details-description">@(string.IsNullOrWhiteSpace(selected.Synopsis) ? "Sinopse ainda não disponível para este título." : selected.Synopsis)</p>
                            <button class="primary-btn" @onclick="() => WatchFeatured(selected)"><span aria-hidden="true">▶</span> Assistir agora</button>
                        </section>
                    </div>
                }
            }
            else
            {
                <section class="empty-hero">
                    <div class="hero-eyebrow"><span class="eyebrow-dot"></span> CATÁLOGO AUTOMÁTICO</div>
                    <h1>Seu entretenimento começa aqui.</h1>
                    <p>@(Featured.Count == 0 ? "Escolha um aplicativo abaixo. Os destaques aparecerão automaticamente quando houver catálogo disponível." : "Filmes e séries em destaque.")</p>
                </section>
            }

            <section class="content-section apps-section">
                <div class="section-heading"><h2>Seus apps</h2>
                    <button class="apps-view-all" @onclick='() => SwitchTab("apps")'>Ver todos <span aria-hidden="true">→</span></button>
                </div>
                <div class="apps-grid">
                    @foreach (var app in Apps.Where(x => x.PinnedToHome))
                    {
                        <button @key="app.Id" class="app-tile app-@app.Icon @HomeAppBrand(app)" title="Abrir @app.Name" @onclick="() => OpenApp(app)">
                            <AppArtwork App="app" /><span class="app-tile-name">@app.Name</span>
                        </button>
                    }
                    @if (!Apps.Any(x => x.PinnedToHome))
                    {
                        <button class="app-tile add-tile" @onclick='() => SwitchTab("apps")'>
                            <span class="app-icon">＋</span><span>Fixar aplicativos</span>
                        </button>
                    }
                </div>
            </section>

            <section class="content-section movies-section">
                <div class="section-heading"><h2>Populares para assistir</h2>
                    @if (Featured.Count > 0) { <button class="apps-view-all" @onclick="() => ShowAllPopular = !ShowAllPopular">@(ShowAllPopular ? "Ver menos" : "Ver todos") <span aria-hidden="true">›</span></button> }
                </div>
                @if (Featured.Count > 0)
                {
                    <div class="movie-row popular-row @(ShowAllPopular ? "movie-row-expanded" : "")">
                        @foreach (var item in Featured)
                        {
                            <button class="movie-card" style="--movie-image: url('@item.ImageUrl')" @onclick="() => WatchFeatured(item)" title="Assistir @item.Title">
                                <img src="@item.ImageUrl" alt="Capa de @item.Title" loading="lazy" />
                                <span class="movie-info"><strong>@item.Title</strong><small>@item.Provider</small></span>
                            </button>
                        }
                        @* O cadastro manual existe apenas nas configurações avançadas. *@
                    </div>
                }
                else
                {
                    <p class="muted">@(CatalogCredentials.IsConfigured ? "Nenhum título com link direto encontrado ainda. Você pode atualizar o catálogo nas Configurações." : "Selecione seus streamings na aba Apps para ver apenas os filmes e séries disponíveis neles.")</p>
                }
            </section>

            @foreach (var row in GenreRows)
            {
                <section class="content-section genre-section" @key="row.Name" aria-label="@row.Name">
                    <div class="section-heading"><h2>@row.Name</h2>
                        @if (row.Titles.Count > 0) { <button class="apps-view-all" @onclick="() => ToggleGenreExpanded(row.Name)">@(ExpandedGenres.Contains(row.Name) ? "Ver menos" : "Ver todos") <span aria-hidden="true">›</span></button> }
                    </div>
                    @if (row.Titles.Count == 0)
                    {
                        <div class="genre-empty" role="status">Catálogo desta categoria sendo atualizado.</div>
                    }
                    else
                    {
                    <div class="movie-row genre-row @(ExpandedGenres.Contains(row.Name) ? "movie-row-expanded" : "")">
                        @foreach (var item in row.Titles)
                        {
                            <button @key="item.RotationKey" class="movie-card" @onclick="() => WatchFeatured(item)" title="Assistir @item.Title">
                                <img src="@item.ImageUrl" alt="Capa de @item.Title" loading="lazy" />
                                <span class="movie-info"><strong>@item.Title</strong><small>@item.Provider</small></span>
                            </button>
                        }
                    </div>
                    }
                </section>
            }
        </main>
    }
    else if (Tab == "apps")
    {
        <main class="inner-page apps-page">
            <div class="apps-page-header">
                <div>
                    <div class="page-eyebrow">SEUS ATALHOS</div>
                    <h1>Apps<span class="accent-period">.</span></h1>
                    <p class="apps-page-subtitle">Sites e programas reunidos em um lugar. Fixe seus favoritos no Início.</p>
                </div>
                <button class="primary-btn apps-new-button" @onclick="NewAppForm">
                    <span aria-hidden="true">＋</span> Novo aplicativo
                </button>
            </div>
            <div class="apps-management-grid">
                <section class="apps-library" aria-label="Aplicativos cadastrados">
                    <div class="apps-library-heading"><h2>Biblioteca</h2><span>@Apps.Count aplicativos</span></div>
                    <div class="apps-library-grid">
                        @foreach (var app in Apps)
                        {
                            <article class="apps-library-card" @key="app.Id">
                                <button class="apps-library-open" title="Abrir @app.Name" @onclick="() => OpenApp(app)">
                                    <AppArtwork App="app" />
                                    <strong>@app.Name</strong>
                                    <small>@(app.Kind == "web" ? "Site" : "Windows")</small>
                                </button>
                                <div class="apps-library-actions">
                                    <button class="@(app.PinnedToHome ? "app-pin-active" : "")"
                                            aria-pressed="@app.PinnedToHome"
                                            title="@(app.PinnedToHome ? "Desafixar do Início" : "Fixar no Início")"
                                            @onclick="() => ToggleAppPinnedAsync(app)">
                                        <span aria-hidden="true">@(app.PinnedToHome ? "★" : "☆")</span>
                                        @(app.PinnedToHome ? "Fixado" : "Fixar")
                                    </button>
                                    @if (app.Kind == "web")
                                    {
                                        <button class="@(app.IncludeInFeatured ? "app-streaming-active" : "")"
                                                title="@(app.IncludeInFeatured ? "Não incluir nos destaques" : "Usar este streaming nos destaques")"
                                                aria-pressed="@app.IncludeInFeatured"
                                                @onclick="() => ToggleFeaturedStreamingAsync(app)">
                                            @(app.IncludeInFeatured ? "✓ Destaques" : "+ Destaques")
                                        </button>
                                    }
                                    <button title="Editar @app.Name" @onclick="() => EditAppForm(app)">Editar</button>
                                    @if (!app.IsBuiltIn)
                                    {
                                        <button class="app-remove-action" title="Remover @app.Name"
                                                @onclick="() => PendingRemoveAppId = app.Id">Remover</button>
                                    }
                                </div>
                                @if (PendingRemoveAppId == app.Id)
                                {
                                    <div class="app-delete-confirm" role="group" aria-label="Confirmar remoção de @app.Name">
                                        <span>Remover @app.Name?</span>
                                        <button @onclick="() => RemoveApp(app.Id)">Confirmar</button>
                                        <button @onclick="() => PendingRemoveAppId = null">Cancelar</button>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                </section>
                @if (ShowAppForm)
                {
                    <section class="apps-editor form-panel" aria-label="Cadastro de aplicativo">
                        <div class="apps-editor-heading">
                            <h2>@(EditingAppId is null ? "Adicionar aplicativo" : "Editar aplicativo")</h2>
                            <button class="apps-editor-close" @onclick="CloseAppForm" aria-label="Fechar formulário">×</button>
                        </div>
                        <div class="apps-icon-preview">
                            @if (!string.IsNullOrWhiteSpace(DraftIconDataUrl))
                            {
                                <img src="@DraftIconDataUrl" alt="Prévia da logo" />
                            }
                            else
                            {
                                <span aria-hidden="true">@(NewAppKind == "desktop" ? "▣" : "↗")</span>
                            }
                            <small>@(IconLoading ? "Buscando logo…" : "Logo do atalho")</small>
                        </div>
                        <label>Tipo de aplicativo
                            <select @bind="NewAppKind">
                                <option value="web">Site / WebView2</option>
                                <option value="desktop">Programa Windows (.exe)</option>
                            </select>
                        </label>
                        <label>@(NewAppKind == "web" ? "Endereço (URL)" : "Caminho do executável")
                            <input @bind="NewAppTarget" @onblur="ResolveIconForFormAsync"
                                   placeholder="@(NewAppKind == "web" ? "https://site.com" : @"C:\Programas\Programa.exe")"
                                   autocomplete="off" />
                        </label>
                        <label>Nome do atalho
                            <input @bind="NewAppName" maxlength="70" placeholder="Nome que aparecerá no Launcher" />
                        </label>
                        <label class="apps-pin-check">
                            <input type="checkbox" @bind="NewAppPinned" /> Fixar no Início
                        </label>
                        @if (NewAppKind == "web")
                        {
                            <div class="apps-streaming-config">
                                <label class="apps-pin-check">
                                    <input type="checkbox" @bind="NewAppFeatured" /> Usar este streaming nos destaques
                                </label>
                                <small>Filmes e séries deste serviço serão encontrados automaticamente, apenas quando houver disponibilidade no Brasil e link direto na API.</small>
                                <label>Serviço correspondente no Watchmode
                                    <select @bind="NewAppSourceId">
                                        <option value="0">Selecione o streaming…</option>
                                        @foreach (var source in AvailableStreamingProviders)
                                        {
                                            <option value="@source.Id">@source.Name</option>
                                        }
                                    </select>
                                </label>
                                @if (LoadingStreamingProviders)
                                {
                                    <small>Carregando lista de serviços disponíveis no Brasil…</small>
                                }
                                else if (AvailableStreamingProviders.Count == 0)
                                {
                                    <small>Não foi possível obter os serviços do Watchmode. A Home continuará funcionando normalmente.</small>
                                    <button class="secondary-btn" @onclick="LoadStreamingProvidersAsync">Tentar carregar serviços</button>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(AppError))
                        {
                            <p class="form-message" role="alert">@AppError</p>
                        }
                        <div class="apps-editor-buttons">
                            <button class="primary-btn" disabled="@SavingApp" @onclick="SaveAppAsync">
                                @(SavingApp ? "Salvando…" : EditingAppId is null ? "Adicionar" : "Salvar alterações")
                            </button>
                            <button class="secondary-btn" @onclick="CloseAppForm">Cancelar</button>
                        </div>
                    </section>
                }
            </div>
        </main>
    }
    else if (Tab == "news")
    {
        <main class="inner-page news-page">
            <div class="news-intro">
                <div>
                    <div class="page-eyebrow">SUA CENTRAL DE INFORMAÇÕES</div>
                    <h1>Notícias<span class="accent-period">.</span></h1>
                        </div>
                <div class="news-update-area">
                    <span class="news-updated">@(NewsUpdatedAt is null ? "Aguardando primeira atualização" : $"Atualizado em {NewsUpdatedAt.Value.ToLocalTime():dd/MM 'às' HH:mm}")</span>
                    <button class="news-refresh-button" disabled="@NewsLoading" @onclick="() => LoadNewsAsync(true)" aria-label="Atualizar notícias agora">
                        <span aria-hidden="true">↻</span> @(NewsLoading ? "Atualizando…" : "Atualizar agora")
                    </button>
                </div>
            </div>
            <nav class="news-filters" aria-label="Filtrar notícias por assunto">
                @foreach (var category in NewsCategories)
                {
                    <button class="@(NewsCategory == category ? "news-filter-active" : "")" aria-pressed="@(NewsCategory == category)"
                            @onclick="() => SetNewsCategory(category)">@category</button>
                }
            </nav>
            @if (News.Count == 0 && NewsLoading)
            {
                <div class="news-loading" role="status">Buscando as últimas notícias e suas imagens…</div>
            }
            else if (News.Count == 0)
            {
                <div class="empty-state">Nenhuma notícia disponível no momento. Verifique sua conexão e tente atualizar novamente.</div>
            }
            else if (VisibleNews.Count == 0)
            {
                <div class="empty-state">Ainda não há notícias nesta categoria. Experimente selecionar “Todas”.</div>
            }
            else
            {
                var lead = VisibleNews.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.ImageUrl)) ?? VisibleNews[0];
                <div class="news-section-heading">
                    <div><span class="news-heading-overline">DESTAQUE</span><h2>Em primeiro plano</h2></div>
                    <span class="news-count">@VisibleNews.Count matérias disponíveis</span>
                </div>
                <section class="news-feature" aria-label="Notícia em destaque">
