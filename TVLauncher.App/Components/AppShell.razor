                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11a9 9 0 1 0-3 7"/><path d="M21 4v7h-7"/></svg>
                            <span><strong>Reiniciar</strong><small>Encerrar a sessão e iniciar o Windows novamente</small></span>
                        </button>
                        <button class="focus-power-option" @onclick="() => SelectPowerAction(SystemPowerAction.Shutdown)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v10"/><path d="M6.3 5.8a9 9 0 1 0 11.4 0"/></svg>
