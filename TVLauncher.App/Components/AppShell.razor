</div>

@code {
    // @key must be unique among siblings. Both hero blocks change with the same title,
    // but cannot share the same render-tree key under the same parent.
    private static string HeroContentKey(FeaturedTitle title) => $"hero-content:{title.RotationKey}";
    private static string HeroShowcaseKey(FeaturedTitle title) => $"hero-showcase:{title.RotationKey}";

    private bool PowerMenuOpen;
    private bool PowerActionBusy;
    private string? PowerActionError;
    private SystemPowerAction? PendingPowerAction;

    private void OpenPowerMenu()
    {
        PowerActionError = null;
        PendingPowerAction = null;
        PowerMenuOpen = true;
    }

    private void ClosePowerMenu()
    {
        if (PowerActionBusy) return;
        PowerMenuOpen = false;
        PendingPowerAction = null;
        PowerActionError = null;
    }

    private void BackToPowerMenu()
    {
        if (PowerActionBusy) return;
        PendingPowerAction = null;
        PowerActionError = null;
    }

    private void SelectPowerAction(SystemPowerAction action)
    {
        PendingPowerAction = action;
        PowerActionError = null;
    }

    private static string PowerActionName(SystemPowerAction action) => action switch
    {
        SystemPowerAction.Sleep => "Suspender",
        SystemPowerAction.Restart => "Reiniciar",
        _ => "Desligar"
    };

    private static string PowerActionDescription(SystemPowerAction action) => action switch
    {
        SystemPowerAction.Sleep => "O computador entrará em suspensão. Ao reativá-lo, você poderá continuar de onde parou. A disponibilidade depende das configurações de energia do Windows.",
        SystemPowerAction.Restart => "O Windows será reiniciado. Salve seu trabalho em outros programas antes de continuar; aplicativos com alterações pendentes podem impedir a operação.",
        _ => "O Windows será desligado. Salve seu trabalho em outros programas antes de continuar; aplicativos com alterações pendentes podem impedir a operação."
    };

    private async Task ConfirmPowerActionAsync()
    {
        if (!PendingPowerAction.HasValue || PowerActionBusy) return;
        PowerActionBusy = true;
        PowerActionError = null;
        try
        {
            await PowerService.ExecuteAsync(PendingPowerAction.Value);
            ClosePowerMenuAfterExecution();
        }
        catch (Exception ex)
        {
            PowerActionError = "Não foi possível executar a operação: " + ex.Message;
        }
        finally
        {
            PowerActionBusy = false;
        }
    }

    private void ClosePowerMenuAfterExecution()
    {
        PowerMenuOpen = false;
        PendingPowerAction = null;
    }

    private string Tab = "home";
    private string TabTitle => Tab switch
    {
        "home" => "Para assistir",
        "apps" => "Seus aplicativos",
        "news" => "Notícias",
        "weather" => "Previsão do tempo",
        _ => "Configurações"
    };
    private bool ShowFeaturedDetails;
    private bool ShowAllPopular;
    private readonly HashSet<string> ExpandedGenres = new(StringComparer.OrdinalIgnoreCase);
    private bool ShowSearch;
    private string SearchText = "";
    private IReadOnlyList<FeaturedTitle> SearchResults => string.IsNullOrWhiteSpace(SearchText)
        ? []
        : Featured.Where(x => x.Title.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase)
                            || x.Provider.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase))
                  .GroupBy(x => x.RotationKey).Select(x => x.First()).Take(20).ToArray();

    private void ToggleSearch() { ShowSearch = !ShowSearch; if (!ShowSearch) SearchText = ""; }
    private void CloseSearch() { ShowSearch = false; SearchText = ""; }
    private async Task OpenSearchResultAsync(FeaturedTitle title) { CloseSearch(); await WatchFeatured(title); }
    private void ToggleGenreExpanded(string genre)
    {
        if (!ExpandedGenres.Add(genre)) ExpandedGenres.Remove(genre);
    }
    private static string HomeAppBrand(LauncherApp app)
    {
        var name = app.Name.ToLowerInvariant();
        if (name.Contains("globoplay")) return "brand-globoplay";
        if (name.Contains("mercado play") || name.Contains("mercadoplay")) return "brand-mercadoplay";
        if (name.Contains("disney")) return "brand-disney";
        if (name.Contains("max")) return "brand-max";
        if (name.Contains("netflix")) return "brand-netflix";
        if (name.Contains("prime")) return "brand-prime";
        if (name.Contains("youtube")) return "brand-youtube";
        if (name.Contains("spotify")) return "brand-spotify";
        return "brand-default";
    }
    private IReadOnlyList<LauncherApp> Apps = [];
    private IReadOnlyList<FeaturedTitle> Featured = [];
    private IReadOnlyList<FeaturedTitle> ManualFeatured = [];
    private bool SelectingFeature;
    private bool CarouselExhausted;
    private IReadOnlyList<GenreRow> GenreRows = [];
    private sealed record GenreRow(string Name, IReadOnlyList<FeaturedTitle> Titles);
    private bool CatalogRefreshing;
    private DateTimeOffset NextCatalogRefresh = DateTimeOffset.UtcNow.AddMinutes(10);
    private IReadOnlyList<NewsItem> News = [];
    private WeatherSnapshot? Weather;
    private bool NewsLoading;
    private bool NewsRequestInProgress;
    private DateTimeOffset? NewsUpdatedAt;
    private DateTimeOffset NextNewsRefresh = DateTimeOffset.UtcNow.AddMinutes(15);
    private string NewsCategory = "Todas";
    private static readonly string[] NewsCategories = ["Todas", "Brasil", "Mundo", "Tecnologia", "Economia", "Geral"];
    private IReadOnlyList<NewsItem> VisibleNews => NewsCategory == "Todas" ? News :
        News.Where(x => x.Category == NewsCategory).ToArray();
    private void SetNewsCategory(string category) => NewsCategory = category;
    private static string FormatNewsTime(DateTimeOffset? date) => date is null
        ? "Data não informada" : date.Value.ToLocalTime().ToString("dd/MM · HH:mm");
    private DateTime Now = DateTime.Now;
    private int ActiveFeature;
    private bool HeroVisible;
    private bool InteractingWithHero;
    private bool PlayTrailer => Tab == "home" && !SuspendedForExternalApp && HeroVisible && InteractingWithHero;
    private DateTimeOffset LastSlideChange = DateTimeOffset.UtcNow;
    private ElementReference HeroElement;
    private ElementReference HeroSelectorElement;
    private DotNetObjectReference<AppShell>? SelfReference;
    private bool ObserverAttached;
    private bool SuspendedForExternalApp;
    private DateTimeOffset NextWeatherRefresh = DateTimeOffset.UtcNow.AddMinutes(30);
    private CancellationTokenSource Life = new();
    private string? Notification;
    private string NewAppName = "", NewAppKind = "web", NewAppTarget = "", AppError = "";
    private bool NewAppPinned, NewAppFeatured;
    private int NewAppSourceId;
    private IReadOnlyList<StreamingProvider> AvailableStreamingProviders = [];
    private bool LoadingStreamingProviders;
    private string? DraftIconDataUrl;
    private string? DraftIconTarget;
    private int? EditingAppId, PendingRemoveAppId;
    private bool ShowAppForm, IconLoading, SavingApp, IconsLoading;
    private string NewTitle = "", NewSynopsis = "", NewDirectUrl = "", NewYoutubeId = "", FeatureError = "";
    private bool ConfirmLink;
    private string NewWatchmodeKey = "", NewTmdbKey = "", CatalogSetupError = "";

    protected override async Task OnInitializedAsync()
    {
        Updater.Changed += OnUpdaterChanged;
        Host.HomeRestored += OnHomeRestored;
        try
        {
            Apps = await Repository.GetAppsAsync();
            _ = LoadAppIconsAsync();
            ManualFeatured = await Repository.GetFeaturedAsync();
            Featured = await Repository.GetHomeFeaturedAsync();
            // Uma ordem aleatória é definida na entrada da Home e permanece fixa.
            await EnterHomeAsync();
        }
        catch (Exception ex) { Notification = $"Erro ao carregar os dados: {ex.Message}"; }
        _ = RefreshWeatherAsync();
        _ = InitializeCatalogMetadataAsync();
        _ = TickAsync(Life.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Tab == "home" && Featured.Count > 0)
        {
            try { await Js.InvokeVoidAsync("tvLauncherHero.ensureActiveIndicatorVisible"); }
            catch (JSException) { }
        }
        if (Tab == "home" && !SuspendedForExternalApp && Featured.Count > 0 && !ObserverAttached)
        {
            SelfReference ??= DotNetObjectReference.Create(this);
            try
            {
                await Js.InvokeVoidAsync("tvLauncherHero.register", HeroElement, HeroSelectorElement, SelfReference);
                ObserverAttached = true;
            }
            catch (JSException) { /* Sem JS: o banner mantém a imagem estática. */ }
        }
    }

    [JSInvokable]
    public async Task HeroVisibilityChanged(bool visible)
    {
        if (HeroVisible == visible) return;
        HeroVisible = visible;
        if (visible) LastSlideChange = DateTimeOffset.UtcNow;
        await InvokeAsync(StateHasChanged);
    }

    // O navegador só cria o iframe quando o banner ou o seletor está em hover/foco.
    // Reinicia a contagem de dez segundos quando o usuário termina de interagir.
    [JSInvokable]
    public async Task HeroInteractionChanged(bool interacting)
    {
        if (InteractingWithHero == interacting) return;
        InteractingWithHero = interacting;
        LastSlideChange = DateTimeOffset.UtcNow;
        await InvokeAsync(StateHasChanged);
    }

    private async Task PreviewFeaturedAsync(int index)
    {
        if (index != ActiveFeature) await SetFeaturedAsync(index);
    }

    private async Task TickAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(() =>
                {
                    Now = DateTime.Now;
                    if (DateTimeOffset.UtcNow >= NextWeatherRefresh)
                    {
                        NextWeatherRefresh = DateTimeOffset.UtcNow.AddMinutes(30);
                        _ = RefreshWeatherAsync();
                    }
                    if (DateTimeOffset.UtcNow >= NextCatalogRefresh)
                    {
                        NextCatalogRefresh = DateTimeOffset.UtcNow.AddMinutes(10);
                        _ = RefreshCatalogAsync();
                    }
                    if (Tab == "news" && DateTimeOffset.UtcNow >= NextNewsRefresh)
                    {
                        NextNewsRefresh = DateTimeOffset.UtcNow.AddMinutes(15);
                        _ = LoadNewsAsync();
                    }
                    if (Tab == "home" && HeroVisible && !InteractingWithHero && !SuspendedForExternalApp &&
                        Featured.Count > 1 && !CarouselExhausted && !SelectingFeature &&
                        DateTimeOffset.UtcNow - LastSlideChange >= TimeSpan.FromSeconds(10))
                    {
                        LastSlideChange = DateTimeOffset.UtcNow;
                        _ = NextFeaturedAsync();
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshWeatherAsync()
    {
        var weather = await WeatherService.GetAsync();
        await InvokeAsync(() => { Weather = weather; StateHasChanged(); });
    }

    private async Task LoadNewsAsync(bool force = false)
    {
        if (NewsRequestInProgress) return;
        NewsRequestInProgress = true;
        NewsLoading = true;
        try
        {
            // Exibe imediatamente o cache SQLite, sem esperar todas as fontes online.
            if (News.Count == 0)
            {
                var saved = await NewsService.GetCachedAsync(Life.Token);
                await InvokeAsync(() =>
                {
                    News = saved.Items;
                    NewsUpdatedAt = saved.UpdatedAt;
                    StateHasChanged();
                });
            }
            var result = await NewsService.GetAsync(force, Life.Token);
            await InvokeAsync(() =>
            {
                News = result.Items;
                NewsUpdatedAt = result.UpdatedAt;
                if (result.IsStale && News.Count > 0)
                    Notification = "Não foi possível atualizar agora. Exibindo notícias salvas.";
                NextNewsRefresh = DateTimeOffset.UtcNow.AddMinutes(15);
            });
        }
        catch (OperationCanceledException) when (Life.IsCancellationRequested) { }
        catch (Exception ex)
        {
            await InvokeAsync(() => Notification = $"Não foi possível atualizar notícias: {ex.Message}");
        }
        finally
        {
            NewsLoading = false;
            NewsRequestInProgress = false;
            if (!Life.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SwitchTab(string newTab)
    {
        if (Tab == "home" && newTab != "home")
        {
            HeroVisible = false;
            InteractingWithHero = false;
            if (ObserverAttached)
            {
                try { await Js.InvokeVoidAsync("tvLauncherHero.unregister"); } catch (JSException) { }
                ObserverAttached = false;
            }
        }
        var returningToHome = Tab != "home" && newTab == "home";
        ShowFeaturedDetails = false;
        CloseSearch();
        Tab = newTab;
        if (returningToHome) await EnterHomeAsync();
        if (newTab == "apps")
        {
            _ = LoadAppIconsAsync();
            _ = LoadStreamingProvidersAsync();
        }
        if (newTab == "news") _ = LoadNewsAsync();
        if (newTab == "weather") await RefreshWeatherAsync();
    }

    private void RebuildGenreRows()
    {
        // A mesma lista de links diretos da Home alimenta todas as categorias.
        // Gêneros não verificados não geram fileiras fictícias.
        GenreRows = ContentGenres.DisplayOrder
            .Select(genre => new GenreRow(genre,
                (IReadOnlyList<FeaturedTitle>)Featured
                    .Where(x => ContentGenres.HasGenre(x.Genres, genre))
                    .ToArray()))
            .Where(row => row.Titles.Count > 0 ||
                (Featured.Count > 0 && ContentGenres.DisplayOrder.Take(6).Contains(row.Name)))
            .ToArray();
    }

    private async Task EnterHomeAsync()
    {
        // Somente a entrada na Home cria outra sequência aleatória.
        Featured = RotationService.ShuffleForHome(Featured);
        ActiveFeature = 0;
        ShowFeaturedDetails = false;
        CarouselExhausted = Featured.Count <= 1;
        InteractingWithHero = false;
        LastSlideChange = DateTimeOffset.UtcNow;
        RebuildGenreRows();
        if (Featured.Count > 0) await RecordCurrentFeatureAsync();
    }

    private async Task RecordCurrentFeatureAsync()
    {
        LastSlideChange = DateTimeOffset.UtcNow;
        try { await Repository.RecordFeaturedViewAsync(Featured[ActiveFeature].RotationKey, Life.Token); }
        catch (OperationCanceledException) when (Life.IsCancellationRequested) { }
    }

    // Avança sempre para o índice seguinte da sequência fixa: 1, 2, 3 ... N.
    // A rotação automática termina no último título; o botão Próximo permite voltar ao primeiro.
    private async Task NextFeaturedAsync(bool manual = false)
    {
        if (SelectingFeature || Featured.Count == 0 || Life.IsCancellationRequested) return;
        if (!manual && ActiveFeature == Featured.Count - 1)
        {
            CarouselExhausted = true;
            return;
        }
        await SetFeaturedAsync((ActiveFeature + 1) % Featured.Count);
    }

    private async Task SetFeaturedAsync(int index)
    {
        if (SelectingFeature || Featured.Count == 0 || Life.IsCancellationRequested) return;
        SelectingFeature = true;
        try
        {
            ActiveFeature = (index % Featured.Count + Featured.Count) % Featured.Count;
            ShowFeaturedDetails = false;
            CarouselExhausted = ActiveFeature == Featured.Count - 1;
            await RecordCurrentFeatureAsync();
        }
        finally
        {
            SelectingFeature = false;
            if (!Life.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    private Task PreviousFeaturedAsync() => SetFeaturedAsync(ActiveFeature - 1);

    private async Task SaveCatalogSettingsAsync()
    {
        CatalogSetupError = "";
        try
        {
            var key = string.IsNullOrWhiteSpace(NewWatchmodeKey) ? CatalogCredentials.WatchmodeKey : NewWatchmodeKey;
            var tmdb = string.IsNullOrWhiteSpace(NewTmdbKey) ? CatalogCredentials.TmdbKey : NewTmdbKey;
            CatalogCredentials.Save(key, tmdb);
            NewWatchmodeKey = NewTmdbKey = "";
            Notification = "Chave armazenada. Consultando a fonte para validar e carregar o catálogo…";
            await RefreshCatalogAsync(true);
            if (Featured.Count > 0) await SwitchTab("home");
        }
        catch (Exception ex) { CatalogSetupError = $"Não foi possível salvar: {ex.Message}"; }
    }

    private async Task InitializeCatalogMetadataAsync()
    {
        if (!TrendingCatalogService.IsConfigured || Life.IsCancellationRequested) return;
        // Primeiro sincroniza novas tendências (respeita o intervalo de 72h),
        // depois enriquece registros antigos, sem recomeçar o carrossel.
        await RefreshCatalogAsync();
        try
        {
            var updated = await TrendingCatalogService.EnrichExistingCatalogAsync(Life.Token);
            if (updated > 0 && !Life.IsCancellationRequested)
                await ReloadCatalogPreservingOrderAsync();
        }
        catch (OperationCanceledException) when (Life.IsCancellationRequested) { }
        catch (Exception) { /* Home permanece funcional com catálogo em cache. */ }
    }

    private async Task ReloadCatalogPreservingOrderAsync()
    {
        var updated = await Repository.GetHomeFeaturedAsync();
        // Um catálogo vazio desmonta o banner e seu observer antigo.
        if (updated.Count == 0 && ObserverAttached)
        {
            try { await Js.InvokeVoidAsync("tvLauncherHero.unregister"); }
            catch (JSException) { }
            ObserverAttached = false;
            HeroVisible = false;
        }
        await InvokeAsync(() =>
        {
            var currentKey = Featured.Count > 0 ? Featured[ActiveFeature].RotationKey : null;
            var latest = updated.ToDictionary(x => x.RotationKey, StringComparer.Ordinal);
            var preserved = Featured.Where(x => latest.ContainsKey(x.RotationKey))
                .Select(x => latest[x.RotationKey]).ToList();
            var existingKeys = preserved.Select(x => x.RotationKey).ToHashSet(StringComparer.Ordinal);
            preserved.AddRange(RotationService.ShuffleForHome(updated
                .Where(x => !existingKeys.Contains(x.RotationKey)).ToArray()));
            Featured = preserved;
            var index = Array.FindIndex(Featured.ToArray(), x => x.RotationKey == currentKey);
            ActiveFeature = index >= 0 ? index : 0;
            CarouselExhausted = Featured.Count <= 1 || ActiveFeature == Featured.Count - 1;
            RebuildGenreRows();
            StateHasChanged();
        });
    }

    private async Task RefreshCatalogAsync(bool force = false)
    {
        if (CatalogRefreshing || Life.IsCancellationRequested || !TrendingCatalogService.IsConfigured) return;
        CatalogRefreshing = true;
        try
        {
            var count = await TrendingCatalogService.RefreshAsync(force, Life.Token);
            if (force)
                Notification = count > 0 ? $"Catálogo atualizado: {count} títulos encontrados." :
                    TrendingCatalogService.LastError ?? "Nenhum novo título encontrado. O catálogo salvo foi preservado.";
            if (count > 0)
            {
                var currentKey = Featured.Count > 0 ? Featured[ActiveFeature].RotationKey : null;
                var updated = await Repository.GetHomeFeaturedAsync();
                await InvokeAsync(async () =>
                {
                    // Mantém a ordem já sorteada enquanto o usuário estiver na Home.
                    // Apenas títulos novos entram no fim, em ordem aleatória entre si.
                    var latest = updated.ToDictionary(x => x.RotationKey, StringComparer.Ordinal);
                    var preserved = Featured.Where(x => latest.ContainsKey(x.RotationKey))
                        .Select(x => latest[x.RotationKey]).ToList();
                    var existingKeys = preserved.Select(x => x.RotationKey).ToHashSet(StringComparer.Ordinal);
                    var additions = RotationService.ShuffleForHome(updated
                        .Where(x => !existingKeys.Contains(x.RotationKey)).ToArray());
                    preserved.AddRange(additions);
                    Featured = preserved;
                    var existing = Array.FindIndex(Featured.ToArray(), x => x.RotationKey == currentKey);
                    ActiveFeature = existing >= 0 ? existing : 0;
                    CarouselExhausted = Featured.Count <= 1 || ActiveFeature == Featured.Count - 1;
                    RebuildGenreRows();
                    LastSlideChange = DateTimeOffset.UtcNow;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (Life.IsCancellationRequested) { }
        catch (Exception ex)
        {
            // Mantém catálogo local funcionando mesmo se a API estiver fora do ar.
            if (force) await InvokeAsync(() => Notification = $"Tendências indisponíveis: {ex.Message}");
        }
        finally
        {
            CatalogRefreshing = false;
            NextCatalogRefresh = DateTimeOffset.UtcNow.AddMinutes(10);
            if (!Life.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    private static string EmbedUrl(string id) => $"https://www.youtube.com/embed/{id}?autoplay=1&mute=1&playsinline=1&enablejsapi=1&controls=1&rel=0";
    private async Task WatchFeatured(FeaturedTitle title) => await OpenWeb(title.DirectUrl, title.Title);
    private async Task OpenApp(LauncherApp app)
    {
        await SuspendHeroAsync();
        try
        {
            if (app.Kind == "desktop") await Host.OpenDesktopAsync(app.Target, app.Name);
            else await Host.OpenWebAsync(app.Target, app.Name);
        }
        catch (Exception error)
        {
            Host.ReturnHome();
            Notification = $"Não foi possível abrir {app.Name}: {error.Message}";
        }
    }
    private async Task OpenWeb(string url, string title)
    {
        await SuspendHeroAsync();
        try { await Host.OpenWebAsync(url, title); }
        catch (Exception error)
        {
            Host.ReturnHome();
            Notification = $"Não foi possível abrir o conteúdo: {error.Message}";
        }
    }
    private async Task OpenNews(NewsItem item) => await OpenWeb(item.Url, item.Source);

    private void NewAppForm()
    {
        EditingAppId = null;
        NewAppName = "";
        NewAppKind = "web";
        NewAppTarget = "";
        NewAppPinned = false;
        NewAppFeatured = false;
        NewAppSourceId = 0;
        DraftIconDataUrl = null;
        DraftIconTarget = null;
        AppError = "";
        ShowAppForm = true;
        PendingRemoveAppId = null;
    }

    private void EditAppForm(LauncherApp app)
    {
        EditingAppId = app.Id;
        NewAppName = app.Name;
        NewAppKind = app.Kind;
        NewAppTarget = app.Target;
        NewAppPinned = app.PinnedToHome;
        NewAppFeatured = app.IncludeInFeatured;
        NewAppSourceId = app.WatchmodeSourceId ??
            StreamingProviderDirectory.MatchByName(app.Name, AvailableStreamingProviders) ?? 0;
        DraftIconDataUrl = app.IconDataUrl;
        DraftIconTarget = app.Target;
        AppError = "";
        ShowAppForm = true;
        PendingRemoveAppId = null;
    }

    private async Task LoadStreamingProvidersAsync()
    {
        if (LoadingStreamingProviders || Life.IsCancellationRequested) return;
        LoadingStreamingProviders = true;
        try
        {
            AvailableStreamingProviders = await StreamingProviders.GetAsync(Life.Token);
            if (ShowAppForm && NewAppSourceId == 0)
            {
                NewAppSourceId = StreamingProviderDirectory.MatchByName(
                    NewAppName, AvailableStreamingProviders) ?? 0;
            }
        }
        catch (OperationCanceledException) when (Life.IsCancellationRequested) { }
        finally
        {
            LoadingStreamingProviders = false;
            if (!Life.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleFeaturedStreamingAsync(LauncherApp app)
    {
        if (!app.IncludeInFeatured && (!app.WatchmodeSourceId.HasValue || app.WatchmodeSourceId <= 0))
        {
            EditAppForm(app);
            Notification = "Selecione o serviço correspondente no Watchmode antes de ativar os destaques.";
            return;
        }
        try
        {
            await Repository.SetFeaturedStreamingAsync(app.Id, !app.IncludeInFeatured);
            Apps = await Repository.GetAppsAsync();
            await ReloadCatalogPreservingOrderAsync();
            NextCatalogRefresh = DateTimeOffset.UtcNow;
            _ = RefreshCatalogAsync();
        }
        catch (Exception ex) { Notification = ex.Message; }
    }

    private void CloseAppForm()
    {
        ShowAppForm = false;
        EditingAppId = null;
        AppError = "";
    }

    private async Task ResolveIconForFormAsync()
    {
        var url = NewAppTarget.Trim();
        if (NewAppKind == "web" && !url.Contains("://", StringComparison.Ordinal) && url.Contains('.'))
        {
            url = "https://" + url;
            NewAppTarget = url;
        }
        if (NewAppKind == "desktop")
        {
            if (url != DraftIconTarget)
            {
                DraftIconTarget = url;
                DraftIconDataUrl = WindowsAppIconService.ReadIcon(url);
                if (string.IsNullOrWhiteSpace(NewAppName) && File.Exists(url))
                    NewAppName = Path.GetFileNameWithoutExtension(url);
            }
            return;
        }
        if (NewAppKind != "web" || !Uri.TryCreate(url, UriKind.Absolute, out var uri) ||
            (uri.Scheme != "http" && uri.Scheme != "https")) return;
        if (url == DraftIconTarget) return;
        IconLoading = true;
        DraftIconTarget = url;
        DraftIconDataUrl = null;
        try
        {
            var result = await IconService.ResolveAsync(url, Life.Token);
            if (NewAppTarget.Trim() == url && !Life.IsCancellationRequested)
            {
                DraftIconDataUrl = result.ImageDataUrl;
                if (string.IsNullOrWhiteSpace(NewAppName)) NewAppName = result.SuggestedName;
                if (NewAppSourceId == 0)
                    NewAppSourceId = StreamingProviderDirectory.MatchByName(
                        NewAppName, AvailableStreamingProviders) ?? 0;
            }
        }
        catch (OperationCanceledException) when (Life.IsCancellationRequested) { }
        finally
        {
            IconLoading = false;
            if (!Life.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveAppAsync()
    {
        if (SavingApp) return;
        SavingApp = true;
        AppError = "";
        try
        {
            var url = NewAppTarget.Trim();
            if (NewAppKind == "web" && !url.Contains("://", StringComparison.Ordinal) && url.Contains('.'))
            {
                url = "https://" + url;
                NewAppTarget = url;
            }
            if (url != DraftIconTarget)
                await ResolveIconForFormAsync();
            if (NewAppFeatured && NewAppSourceId == 0)
                NewAppSourceId = StreamingProviderDirectory.MatchByName(
                    NewAppName, AvailableStreamingProviders) ?? 0;
            if (EditingAppId is int id)
                await Repository.UpdateAppAsync(id, NewAppName, NewAppKind, url, NewAppPinned,
                    DraftIconDataUrl, NewAppFeatured && NewAppKind == "web",
                    NewAppSourceId > 0 ? NewAppSourceId : null);
            else
                await Repository.AddAppAsync(NewAppName, NewAppKind, url, NewAppPinned,
                    DraftIconDataUrl, NewAppFeatured && NewAppKind == "web",
                    NewAppSourceId > 0 ? NewAppSourceId : null);
            Apps = await Repository.GetAppsAsync();
            await ReloadCatalogPreservingOrderAsync();
            NextCatalogRefresh = DateTimeOffset.UtcNow;
            _ = RefreshCatalogAsync();
            CloseAppForm();
            Notification = "Atalho salvo.";
            _ = LoadAppIconsAsync();
        }
        catch (Exception ex) { AppError = ex.Message; }
        finally { SavingApp = false; }
    }

    private async Task ToggleAppPinnedAsync(LauncherApp app)
    {
        await Repository.SetAppPinnedAsync(app.Id, !app.PinnedToHome);
        Apps = await Repository.GetAppsAsync();
    }

    private async Task LoadAppIconsAsync()
    {
        if (IconsLoading || Life.IsCancellationRequested) return;
        IconsLoading = true;
        try
        {
            var threshold = DateTimeOffset.UtcNow.AddDays(-14).ToUnixTimeSeconds();
            foreach (var app in Apps.Where(a => a.Kind == "web" &&
                         string.IsNullOrWhiteSpace(a.IconDataUrl) &&
                         a.IconCheckedAtUnix < threshold).ToArray())
            {
                if (Life.IsCancellationRequested) break;
                var data = await IconService.ResolveAsync(app.Target, Life.Token);
                await Repository.SaveAppIconAsync(app.Id, app.Target, data.ImageDataUrl);
                Apps = await Repository.GetAppsAsync();
                if (!Life.IsCancellationRequested) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (Life.IsCancellationRequested) { }
        catch (Exception) { /* Ícone opcional: apps e Home continuam disponíveis. */ }
        finally { IconsLoading = false; }
    }

    private async Task AddFeatured()
    {
        FeatureError = "";
        if (!ConfirmLink) { FeatureError = "Teste o link direto antes de adicioná-lo ao catálogo."; return; }
        try
        {
            await Repository.AddFeaturedAsync(NewTitle, NewSynopsis, NewDirectUrl, NewYoutubeId);
            ManualFeatured = await Repository.GetFeaturedAsync();
            Featured = await Repository.GetHomeFeaturedAsync();
            await EnterHomeAsync();
            NewTitle = NewSynopsis = NewDirectUrl = NewYoutubeId = "";
            ConfirmLink = false;
        }
        catch (Exception error) { FeatureError = error.Message; }
    }
    private async Task RemoveApp(int id)
    {
        await Repository.RemoveAppAsync(id);
        Apps = await Repository.GetAppsAsync();
        PendingRemoveAppId = null;
        if (EditingAppId == id) CloseAppForm();
        await ReloadCatalogPreservingOrderAsync();
    }
    private async Task RemoveFeatured(int id)
    {
        await Repository.RemoveFeaturedAsync(id);
        ManualFeatured = await Repository.GetFeaturedAsync();
        Featured = await Repository.GetHomeFeaturedAsync();
        await EnterHomeAsync();
    }
    private void OpenDesktop() => Host.ShowDesktop();

    private async Task SuspendHeroAsync()
    {
        SuspendedForExternalApp = true;
        HeroVisible = false;
        InteractingWithHero = false;
        if (ObserverAttached)
        {
            try { await Js.InvokeVoidAsync("tvLauncherHero.unregister"); } catch (JSException) { }
            ObserverAttached = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnHomeRestored() => _ = InvokeAsync(async () =>
    {
        SuspendedForExternalApp = false;
        Tab = "home";
        InteractingWithHero = false;
        await EnterHomeAsync();
        StateHasChanged();
    });

    private void OnUpdaterChanged() => _ = InvokeAsync(StateHasChanged);

    private void RestartForUpdate()
    {
        Host.RequestUpdateRestart();
    }

    public async ValueTask DisposeAsync()
    {
        Updater.Changed -= OnUpdaterChanged;
        Host.HomeRestored -= OnHomeRestored;
        Life.Cancel();
        Life.Dispose();
        try { await Js.InvokeVoidAsync("tvLauncherHero.unregister"); } catch { }
        SelfReference?.Dispose();
    }
}
