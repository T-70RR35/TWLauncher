                {
                    <p class="focus-power-description">Escolha o que deseja fazer com o computador.</p>
                    <div class="focus-power-options">
                        <button class="focus-power-option" @onclick="() => SelectPowerAction(SystemPowerAction.Sleep)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 14.8A9 9 0 0 1 9.2 3.8 9 9 0 1 0 20.2 14.8Z"/></svg>
